# Normalize line endings to LF in the repo; check out as-is on all platforms
* text=auto eol=lf

# Force these to always be LF
*.ts   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sh   text eol=lf

# Binary — never touch line endings
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.zip  binary
